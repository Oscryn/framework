{
    "name": "oscryn/framework",
    "description": "Oscryn — a tiny, modern PHP framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "latte/latte": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Oscryn\\": "src/Oscryn/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:plain": "phpunit"
    },
    "bin": [
        "bin/oscryn-ide-helper"
    ]
}
